# TEMPLATE ONLY: this file is committed to GitHub. Never put real keys or passwords here.
# Copy it to .env.local (Git-ignored) and fill in .env.local from YOUR Supabase project:
#   Supabase dashboard → Project Settings → API / API keys.
# Never commit .env.local. Never put the secret key or the database password in Vercel or in code.

# --- Used by the website (also set these in Vercel → Settings → Environment Variables) ---
# Project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…; older dashboards call it the "anon" key). Safe to expose:
# Row Level Security and is_admin() decide what anyone can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
# Optional: the public address, used for link-preview image URLs. Without it, Vercel's production domain is used.
NEXT_PUBLIC_SITE_URL=

# --- Local scripts only (npm run seed, backup:live, …). NEVER in Vercel, NEVER in client code ---
# Secret / service-role key: bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=replace_me_locally_only
# Database password chosen when the project was created (full backups with pg_dump only; optional).
SUPABASE_DB_PASSWORD=replace_me_locally_only
# The admin's sign-in email: `npm run seed` registers this Supabase Auth user as the one admin.
ADMIN_EMAIL=scorekeeper@example.com
# Optional: where `npm run backup:live` writes (default ~/cst-live-backups).
# BACKUP_DIR=/path/to/backups
